@page
@model Project.Pages.ReportModel

<section class="hero">
    <p class="eyebrow">Reports</p>
    <h1>Collection Report</h1>
</section>

<section class="overview">
    <form method="get" class="search-form">
        <input type="hidden" name="Generate" value="true" />

        <select name="SelectedType">
            <option value="">All types</option>
            @foreach (var t in Model.Types)
            {
                <option value="@t.Value" selected="@(t.Value == Model.SelectedType)">@t.Label</option>
            }
        </select>

        <select name="SelectedStatus">
            <option value="">All statuses</option>
            @foreach (var s in Model.Statuses)
            {
                <option value="@s" selected="@(s == Model.SelectedStatus)">@s</option>
            }
        </select>

        <button type="submit" class="button button-primary">View Report</button>
    </form>
</section>

@if (Model.Generate)
{
    <section>
       
        <div class="print-only report-title">Library Collection Report</div>
        <div class="print-only report-subtitle">
            Type: @(string.IsNullOrEmpty(Model.SelectedType) ? "All" : Model.SelectedType)
            &nbsp;·&nbsp;
            Status: @(string.IsNullOrEmpty(Model.SelectedStatus) ? "All" : Model.SelectedStatus)
        </div>

       
        <p class="no-print">
            Generated @Model.GeneratedAt.ToString("MMMM d, yyyy h:mm tt") ·
            Type: @(string.IsNullOrEmpty(Model.SelectedType) ? "All" : Model.SelectedType) ·
            Status: @(string.IsNullOrEmpty(Model.SelectedStatus) ? "All" : Model.SelectedStatus)
        </p>

        @if (Model.Items.Count == 0)
        {
            <p>No items match these filters.</p>
        }
        else
        {
            <h2>Summary</h2>
            <table class="results">
                <tr>
                    <th>Type</th>
                    @foreach (var s in Model.Statuses) { <th class="num">@s</th> }
                    <th class="num">Total</th>
                </tr>
                @foreach (var t in Model.TypesInReport)
                {
                    <tr>
                        <td>@t.Label</td>
                        @foreach (var s in Model.Statuses) { <td class="num">@Model.Count(t.Value, s)</td> }
                        <td class="num"><strong>@Model.Items.Count(i => i.Type == t.Value)</strong></td>
                    </tr>
                }
                <tr class="total">
                    <td>Total</td>
                    @foreach (var s in Model.Statuses) { <td class="num">@Model.Items.Count(i => i.Status == s)</td> }
                    <td class="num">@Model.Items.Count</td>
                </tr>
            </table>

            <h2 style="margin-top: 40px;">Items by type</h2>
            @foreach (var t in Model.TypesInReport)
            {
                var group = Model.Items.Where(i => i.Type == t.Value).ToList();

                <h3 style="margin-top: 28px;">@t.Label</h3>
                <table class="results">
                    <tr><th>Name</th><th>Details</th><th>Status</th><th>Barcode</th></tr>
                    @foreach (var i in group)
                    {
                        <tr>
                            <td><a asp-page="/ItemDetails" asp-route-id="@i.Id">@i.Name</a></td>
                            <td>@i.DetailsSummary()</td>
                            <td>@i.Status</td>
                            <td>@i.barcode</td>
                        </tr>
                    }
                    <tr class="subtotal">
                        <td colspan="3" class="num">Sub Total</td>
                        <td class="num">@group.Count</td>
                    </tr>
                </table>
            }

            <p class="grand-total"><strong>Grand Total: @Model.Items.Count items</strong></p>
        }

        
        <div class="print-only report-footer">
            Generated @Model.GeneratedAt.ToString("M/d/yyyy h:mm:ss tt")
        </div>

        <p class="no-print" style="margin-top: 16px;">
            <button class="button" onclick="window.print()">Print / Save as PDF</button>
        </p>
    </section>
}