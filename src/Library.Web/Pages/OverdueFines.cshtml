@page
@model Project.Pages.OverdueFinesModel
@using Project.Configuration
@using System.Globalization

@{
    ViewData["Title"] = "Overdue Returns & Fines";
    double rateChange = Model.LateRate - Model.PrevLateRate;
    int lateTotal = Model.ReturnedLate + Model.StillOutOverdue;
    decimal accruing = Model.OverdueNow.Sum(o => o.EstimatedFine);
    // Links to the supporting records: the report's filters plus what a number was counted from
    Dictionary<string, string> R(params string[] kv)
    {
        var d = new Dictionary<string, string>();
        if (Model.From != null) d["From"] = Model.From.Value.ToString("yyyy-MM-dd");
        if (Model.To != null) d["To"] = Model.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(Model.Category)) d["Category"] = Model.Category;
        if (!string.IsNullOrEmpty(Model.BorrowerType)) d["BorrowerType"] = Model.BorrowerType;
        for (int i = 0; i + 1 < kv.Length; i += 2)
        {
            if (string.IsNullOrEmpty(kv[i + 1])) d.Remove(kv[i]); else d[kv[i]] = kv[i + 1];
        }
        return d;
    }
    string ValueOf(string label) => LibraryOptions.Types.Where(t => t.Label == label).Select(t => t.Value).FirstOrDefault() ?? label;
    string Ym(string monthLabel) => DateTime.TryParseExact(monthLabel, "MMM yyyy", CultureInfo.CurrentCulture, DateTimeStyles.None, out var md) ? md.ToString("yyyy-MM") : "";
    string categoryLabel = string.IsNullOrEmpty(Model.Category) ? "All categories"
        : LibraryOptions.Types.Where(t => t.Value == Model.Category).Select(t => t.Label).FirstOrDefault() ?? Model.Category;
}

<!-- Header -->
<div class="report-header">
    <div>
        <p class="eyebrow">Reports</p>
        <h1>Overdue Returns &amp; Fines</h1>
        <p class="report-lede">How often items come back late, who returns them late, and how much of the fines are collected.</p>
        <p class="report-meta">
            Loans due @Model.From?.ToString("MMM d, yyyy") – @Model.To?.ToString("MMM d, yyyy")
            · @categoryLabel
            · @(string.IsNullOrEmpty(Model.BorrowerType) ? "All borrowers" : Model.BorrowerType)
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-library-outline" asp-page="/OverdueRecords" asp-all-route-data='R()'>View all records</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</div>
<p class="report-meta no-print" style="margin-top: -8px;">Click any <span class="drill-num">underlined number</span> to see the records it was counted from.</p>

<!-- Filters -->
<section class="overview no-print">
    <form method="get" class="search-form">
        <label>From <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>

        <select name="Category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var t in LibraryOptions.Types)
            {
                <option value="@t.Value" selected="@(t.Value == Model.Category)">@t.Label</option>
            }
        </select>

        <select name="BorrowerType" aria-label="Borrower type">
            <option value="">All borrowers</option>
            @foreach (var b in new[] { "Student", "Faculty" })
            {
                <option value="@b" selected="@(b == Model.BorrowerType)">@b</option>
            }
        </select>

        <button type="submit" class="button button-primary">View Report</button>
    </form>
</section>

<!-- Headline numbers -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-label">Loans due</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans")'>@Model.LoansDue</a></div>
        <div class="kpi-note">@Model.ReturnedOnTime returned on time</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Late-return rate</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Outcome", "late")'>@Model.LateRate.ToString("0")%</a></div>
        <div class="kpi-note">
            @if (Model.PrevLateRate > 0)
            {
                <span><strong>@(rateChange >= 0 ? "▲ +" : "▼ ")@rateChange.ToString("0") pts</strong> vs. previous period (@(rateChange > 0 ? "worse" : rateChange < 0 ? "better" : "no change"))</span>
            }
            else
            {
                <span>@lateTotal of @Model.LoansDue loans late</span>
            }
        </div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Average days late</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Outcome", "late")'>@Model.AvgDaysLate.ToString("0.0")</a></div>
        <div class="kpi-note">across @lateTotal late loans</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Overdue right now</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "overdue-now")'>@Model.OverdueNow.Count</a></div>
        <div class="kpi-note"><strong>@accruing.ToString("C")</strong> in fines accruing</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Fines outstanding</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "fines", "Paid", "unpaid")'>@Model.FinesOutstanding.ToString("C")</a></div>
        <div class="kpi-note">of @Model.FinesAssessed.ToString("C") assessed</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Collection rate</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "payments")'>@Model.CollectionRate.ToString("0")%</a></div>
        <div class="kpi-note">@Model.PaymentsReceived.ToString("C") received this period</div>
    </div>
</div>

<!-- Findings -->
<section class="findings">
    <h2>Findings &amp; recommendations</h2>
    <ol>
        @foreach (var r in Model.Recommendations)
        {
            <li>@r</li>
        }
    </ol>
</section>

<!-- By category -->
<section class="report-section">
    <h2>Late returns by category</h2>
    @if (Model.ByCategory.Count == 0)
    {
        <p>No loans were due in this period.</p>
    }
    else
    {
        <table class="results">
            <tr>
                <th>Category</th><th class="num">Loans due</th><th class="num">Late</th>
                <th class="num">Still out</th><th class="num">Late rate</th>
                <th class="num">Avg days late</th><th class="num">Fines assessed</th>
            </tr>
            @foreach (var c in Model.ByCategory)
            {
                <tr>
                    <td>@c.Group</td>
                    <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Category", ValueOf(c.Group))'>@c.Due</a></td>
                    <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Category", ValueOf(c.Group), "Outcome", "late")'>@c.Late</a></td>
                    <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Category", ValueOf(c.Group), "Outcome", "still-overdue")'>@c.StillOverdue</a></td>
                    <td class="num">@c.LateRate.ToString("0")%</td>
                    <td class="num">@c.AvgDaysLate.ToString("0.0")</td>
                    <td class="num">@c.Fines.ToString("C")</td>
                </tr>
            }
            <tr class="total">
                <td>Total</td>
                <td class="num">@Model.LoansDue</td>
                <td class="num">@lateTotal</td>
                <td class="num">@Model.StillOutOverdue</td>
                <td class="num">@Model.LateRate.ToString("0")%</td>
                <td class="num">@Model.AvgDaysLate.ToString("0.0")</td>
                <td class="num">@Model.ByCategory.Sum(c => c.Fines).ToString("C")</td>
            </tr>
        </table>
    }
</section>

<!-- Monthly trend -->
<section class="report-section">
        <h2>Monthly late-return rate</h2>
        <table class="results">
            <tr><th>Month</th><th class="num">Loans due</th><th class="num">Late</th><th class="num">Late rate</th></tr>
            @foreach (var m in Model.Monthly)
            {
                <tr>
                    <td>@m.Month</td>
                    <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Month", Ym(m.Month))'>@m.Due</a></td>
                    <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Month", Ym(m.Month), "Outcome", "late")'>@m.Late</a></td>
                    <td class="num">@(m.Due == 0 ? "—" : m.LateRate.ToString("0") + "%")</td>
                </tr>
            }
        </table>
</section>

<!-- Monthly fines and collections -->
<section class="report-section">
    <h2>Fines charged and collected by month</h2>
    <table class="results">
        <tr>
            <th>Month</th><th class="num">Fines</th><th class="num">Charged</th>
            <th class="num">Payments</th><th class="num">Collected</th><th class="num">Still unpaid</th>
        </tr>
        @foreach (var m in Model.MonthlyFines)
        {
            <tr>
                <td>@m.Month</td>
                <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "fines", "Month", Ym(m.Month))'>@m.FinesCount</a></td>
                <td class="num">@m.Assessed.ToString("C")</td>
                <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "payments", "Month", Ym(m.Month))'>@m.PaymentsCount</a></td>
                <td class="num">@m.Collected.ToString("C")</td>
                <td class="num">@if (m.StillUnpaid == 0) { <span>—</span> } else { <a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "fines", "Month", Ym(m.Month), "Paid", "unpaid")'>@m.StillUnpaid.ToString("C")</a> }</td>
            </tr>
        }
        <tr class="total">
            <td>Total</td>
            <td class="num">@Model.MonthlyFines.Sum(m => m.FinesCount)</td>
            <td class="num">@Model.MonthlyFines.Sum(m => m.Assessed).ToString("C")</td>
            <td class="num">@Model.MonthlyFines.Sum(m => m.PaymentsCount)</td>
            <td class="num">@Model.MonthlyFines.Sum(m => m.Collected).ToString("C")</td>
            <td class="num">@Model.MonthlyFines.Sum(m => m.StillUnpaid).ToString("C")</td>
        </tr>
    </table>
</section>

<!-- Repeat late returners + payments side by side -->
<div class="report-grid-2">
    <section class="report-section">
        <h2>Members with repeated late returns</h2>
        @if (Model.RepeatLateReturners.Count == 0)
        {
            <p>No member returned items late more than once.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Member</th><th>Type</th><th class="num">Late returns</th><th class="num">Fines</th><th class="num">Unpaid</th></tr>
                @foreach (var r in Model.RepeatLateReturners)
                {
                    <tr>
                        <td>@r.Borrower</td>
                        <td>@r.BorrowerType</td>
                        <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "loans", "Outcome", "late", "MemberId", r.MemberId.ToString())'>@r.LateReturns</a></td>
                        <td class="num">@r.FinesAssessed.ToString("C")</td>
                        <td class="num">@r.Unpaid.ToString("C")</td>
                    </tr>
                }
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Payments by method</h2>
        @if (Model.PaymentsByMethod.Count == 0)
        {
            <p>No payments were received in this period.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Method</th><th class="num">Payments</th><th class="num">Amount</th></tr>
                @foreach (var p in Model.PaymentsByMethod)
                {
                    <tr>
                        <td>@(p.Method.Length > 0 ? char.ToUpper(p.Method[0]) + p.Method[1..] : p.Method)</td>
                        <td class="num"><a class="drill-num" asp-page="/OverdueRecords" asp-all-route-data='R("Show", "payments", "Method", p.Method)'>@p.Count</a></td>
                        <td class="num">@p.Amount.ToString("C")</td>
                    </tr>
                }
                <tr class="total">
                    <td>Total</td>
                    <td class="num">@Model.PaymentsByMethod.Sum(p => p.Count)</td>
                    <td class="num">@Model.PaymentsReceived.ToString("C")</td>
                </tr>
            </table>
        }
    </section>
</div>

<p class="report-meta" style="font-size: 13px; color: #5f6b64;">
    Compared with the previous period @Model.PrevFrom.ToString("MMM d, yyyy") – @Model.PrevTo.ToString("MMM d, yyyy").
    A loan is late if it was returned after its due date or is still out past it. Collected = payments received that month; still unpaid = that month's fines not yet paid. Fines follow the <a asp-page="/Policies">borrowing &amp; fines policy</a>.
    Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt").
</p>
