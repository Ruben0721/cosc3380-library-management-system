@page
@model Project.Pages.OverdueFinesModel
@using Project.Configuration

@{
    ViewData["Title"] = "Overdue Returns & Fines";
    double rateChange = Model.LateRate - Model.PrevLateRate;
    int lateTotal = Model.ReturnedLate + Model.StillOutOverdue;
    decimal accruing = Model.OverdueNow.Sum(o => o.EstimatedFine);
    string Pct(int part, int whole) => whole == 0 ? "—" : (100.0 * part / whole).ToString("0") + "%";
    string categoryLabel = string.IsNullOrEmpty(Model.Category) ? "All categories"
        : LibraryOptions.Types.Where(t => t.Value == Model.Category).Select(t => t.Label).FirstOrDefault() ?? Model.Category;
}

<!-- Header -->
<div class="report-header">
    <div>
        <p class="eyebrow">Reports</p>
        <h1>Overdue Returns &amp; Fines</h1>
        <p class="report-lede">How often items come back late, who returns them late, and how much of the fines are collected.</p>
        <p class="report-meta">
            Loans due @Model.From?.ToString("MMM d, yyyy") – @Model.To?.ToString("MMM d, yyyy")
            · @categoryLabel
            · @(string.IsNullOrEmpty(Model.BorrowerType) ? "All borrowers" : Model.BorrowerType)
        </p>
    </div>
    <button type="button" class="btn btn-outline-secondary no-print" onclick="window.print()">Print / Save as PDF</button>
</div>

<!-- Filters -->
<section class="overview no-print">
    <form method="get" class="search-form">
        <label>From <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>

        <select name="Category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var t in LibraryOptions.Types)
            {
                <option value="@t.Value" selected="@(t.Value == Model.Category)">@t.Label</option>
            }
        </select>

        <select name="BorrowerType" aria-label="Borrower type">
            <option value="">All borrowers</option>
            @foreach (var b in new[] { "Student", "Faculty" })
            {
                <option value="@b" selected="@(b == Model.BorrowerType)">@b</option>
            }
        </select>

        <button type="submit" class="button button-primary">View Report</button>
    </form>
</section>

<!-- Headline numbers -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-label">Loans due</div>
        <div class="kpi-value">@Model.LoansDue</div>
        <div class="kpi-note">@Model.ReturnedOnTime returned on time</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Late-return rate</div>
        <div class="kpi-value">@Model.LateRate.ToString("0")%</div>
        <div class="kpi-note">
            @if (Model.PrevLateRate > 0)
            {
                <span><strong>@(rateChange >= 0 ? "▲ +" : "▼ ")@rateChange.ToString("0") pts</strong> vs. previous period (@(rateChange > 0 ? "worse" : rateChange < 0 ? "better" : "no change"))</span>
            }
            else
            {
                <span>@lateTotal of @Model.LoansDue loans late</span>
            }
        </div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Average days late</div>
        <div class="kpi-value">@Model.AvgDaysLate.ToString("0.0")</div>
        <div class="kpi-note">across @lateTotal late loans</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Overdue right now</div>
        <div class="kpi-value">@Model.OverdueNow.Count</div>
        <div class="kpi-note"><strong>@accruing.ToString("C")</strong> in fines accruing</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Fines outstanding</div>
        <div class="kpi-value">@Model.FinesOutstanding.ToString("C")</div>
        <div class="kpi-note">of @Model.FinesAssessed.ToString("C") assessed</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Collection rate</div>
        <div class="kpi-value">@Model.CollectionRate.ToString("0")%</div>
        <div class="kpi-note">@Model.PaymentsReceived.ToString("C") received this period</div>
    </div>
</div>

<!-- Findings -->
<section class="findings">
    <h2>Findings &amp; recommendations</h2>
    <ol>
        @foreach (var r in Model.Recommendations)
        {
            <li>@r</li>
        }
    </ol>
</section>

<!-- Loan outcomes + fine collection side by side -->
<div class="report-grid-2">
    <section class="report-section">
        <h2>Loan outcomes</h2>
        <table class="results">
            <tr><th>Outcome</th><th class="num">Loans</th><th class="num">Share</th></tr>
            <tr><td>Returned on time</td><td class="num">@Model.ReturnedOnTime</td><td class="num">@Pct(Model.ReturnedOnTime, Model.LoansDue)</td></tr>
            <tr><td>Returned late</td><td class="num">@Model.ReturnedLate</td><td class="num">@Pct(Model.ReturnedLate, Model.LoansDue)</td></tr>
            <tr><td>Still out, overdue</td><td class="num">@Model.StillOutOverdue</td><td class="num">@Pct(Model.StillOutOverdue, Model.LoansDue)</td></tr>
            <tr><td>Still out, not yet due</td>
                <td class="num">@(Model.LoansDue - Model.ReturnedOnTime - lateTotal)</td>
                <td class="num">@Pct(Model.LoansDue - Model.ReturnedOnTime - lateTotal, Model.LoansDue)</td></tr>
            <tr class="total"><td>Total</td><td class="num">@Model.LoansDue</td><td class="num">100%</td></tr>
        </table>
    </section>

    <section class="report-section">
        <h2>Fine collection</h2>
        @if (Model.FinesByType.Count == 0)
        {
            <p>No fines were assessed in this period.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Type</th><th class="num">Count</th><th class="num">Assessed</th><th class="num">Outstanding</th><th class="num">Collected</th></tr>
                @foreach (var f in Model.FinesByType)
                {
                    <tr>
                        <td>@f.FineType</td>
                        <td class="num">@f.Count</td>
                        <td class="num">@f.Assessed.ToString("C")</td>
                        <td class="num">@f.Outstanding.ToString("C")</td>
                        <td class="num">@(f.Assessed == 0 ? "—" : ((double)(f.Paid / f.Assessed) * 100).ToString("0") + "%")</td>
                    </tr>
                }
                <tr class="total">
                    <td>Total</td>
                    <td class="num">@Model.FinesByType.Sum(f => f.Count)</td>
                    <td class="num">@Model.FinesAssessed.ToString("C")</td>
                    <td class="num">@Model.FinesOutstanding.ToString("C")</td>
                    <td class="num">@Model.CollectionRate.ToString("0")%</td>
                </tr>
            </table>
        }
    </section>
</div>

<!-- Overdue right now -->
<section class="report-section">
    <h2 class="section-title">Items overdue right now (@Model.OverdueNow.Count) <a class="section-link no-print" asp-page="/Staff/Returns" asp-route-OverdueOnly="true">Check in overdue items →</a></h2>
    @if (Model.OverdueNow.Count == 0)
    {
        <p>No items are overdue right now.</p>
    }
    else
    {
        <table class="results">
            <tr>
                <th>Item</th><th>Category</th><th>Borrower</th><th>Borrower type</th>
                <th>Due date</th><th class="num">Days overdue</th><th class="num">Fine so far</th>
            </tr>
            @foreach (var o in Model.OverdueNow)
            {
                <tr>
                    <td>@o.ItemName</td>
                    <td>@o.Category</td>
                    <td>@o.Borrower</td>
                    <td>@o.BorrowerType</td>
                    <td>@o.DueDate.ToString("MMM d, yyyy")</td>
                    <td class="num">@o.DaysOverdue</td>
                    <td class="num">@o.EstimatedFine.ToString("C")</td>
                </tr>
            }
            <tr class="total">
                <td colspan="6">Total</td>
                <td class="num">@accruing.ToString("C")</td>
            </tr>
        </table>
    }
</section>

<!-- By category -->
<section class="report-section">
    <h2>Late returns by category</h2>
    @if (Model.ByCategory.Count == 0)
    {
        <p>No loans were due in this period.</p>
    }
    else
    {
        <table class="results">
            <tr>
                <th>Category</th><th class="num">Loans due</th><th class="num">Late</th>
                <th class="num">Still out</th><th class="num">Late rate</th>
                <th class="num">Avg days late</th><th class="num">Fines assessed</th>
            </tr>
            @foreach (var c in Model.ByCategory)
            {
                <tr>
                    <td>@c.Group</td>
                    <td class="num">@c.Due</td>
                    <td class="num">@c.Late</td>
                    <td class="num">@c.StillOverdue</td>
                    <td class="num">@c.LateRate.ToString("0")%</td>
                    <td class="num">@c.AvgDaysLate.ToString("0.0")</td>
                    <td class="num">@c.Fines.ToString("C")</td>
                </tr>
            }
            <tr class="total">
                <td>Total</td>
                <td class="num">@Model.LoansDue</td>
                <td class="num">@lateTotal</td>
                <td class="num">@Model.StillOutOverdue</td>
                <td class="num">@Model.LateRate.ToString("0")%</td>
                <td class="num">@Model.AvgDaysLate.ToString("0.0")</td>
                <td class="num">@Model.ByCategory.Sum(c => c.Fines).ToString("C")</td>
            </tr>
        </table>
    }
</section>

<!-- By borrower type + monthly trend side by side -->
<div class="report-grid-2">
    <section class="report-section">
        <h2>By borrower type</h2>
        @if (Model.ByBorrowerType.Count == 0)
        {
            <p>No loans were due in this period.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Borrower type</th><th class="num">Loans due</th><th class="num">Late</th><th class="num">Late rate</th><th class="num">Fines</th></tr>
                @foreach (var b in Model.ByBorrowerType)
                {
                    <tr>
                        <td>@b.Group</td>
                        <td class="num">@b.Due</td>
                        <td class="num">@b.Late</td>
                        <td class="num">@b.LateRate.ToString("0")%</td>
                        <td class="num">@b.Fines.ToString("C")</td>
                    </tr>
                }
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Monthly late-return rate</h2>
        <table class="results">
            <tr><th>Month</th><th class="num">Loans due</th><th class="num">Late</th><th class="num">Late rate</th></tr>
            @foreach (var m in Model.Monthly)
            {
                <tr>
                    <td>@m.Month</td>
                    <td class="num">@m.Due</td>
                    <td class="num">@m.Late</td>
                    <td class="num">@(m.Due == 0 ? "—" : m.LateRate.ToString("0") + "%")</td>
                </tr>
            }
        </table>
    </section>
</div>


<div class="report-grid-2">
    <section class="report-section">
        <h2>Members with repeated late returns</h2>
        @if (Model.RepeatLateReturners.Count == 0)
        {
            <p>No member returned items late more than once.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Member</th><th>Type</th><th class="num">Late returns</th><th class="num">Fines</th><th class="num">Unpaid</th></tr>
                @foreach (var r in Model.RepeatLateReturners)
                {
                    <tr>
                        <td>@r.Borrower</td>
                        <td>@r.BorrowerType</td>
                        <td class="num">@r.LateReturns</td>
                        <td class="num">@r.FinesAssessed.ToString("C")</td>
                        <td class="num">@r.Unpaid.ToString("C")</td>
                    </tr>
                }
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Payments by method</h2>
        @if (Model.PaymentsByMethod.Count == 0)
        {
            <p>No payments were received in this period.</p>
        }
        else
        {
            <table class="results">
                <tr><th>Method</th><th class="num">Payments</th><th class="num">Amount</th></tr>
                @foreach (var p in Model.PaymentsByMethod)
                {
                    <tr>
                        <td>@(p.Method.Length > 0 ? char.ToUpper(p.Method[0]) + p.Method[1..] : p.Method)</td>
                        <td class="num">@p.Count</td>
                        <td class="num">@p.Amount.ToString("C")</td>
                    </tr>
                }
                <tr class="total">
                    <td>Total</td>
                    <td class="num">@Model.PaymentsByMethod.Sum(p => p.Count)</td>
                    <td class="num">@Model.PaymentsReceived.ToString("C")</td>
                </tr>
            </table>
        }
    </section>
</div>

<!-- Fine policy -->
<section class="report-section">
    <h2>Fine policy (reference)</h2>
    <table class="results">
        <tr>
            <th>Category</th><th class="num">Loan days</th><th class="num">Per day late</th>
            <th class="num">Overdue cap</th><th class="num">Damage fee</th><th class="num">Replacement cost</th>
        </tr>
        @foreach (var p in Model.Policies)
        {
            <tr>
                <td>@(LibraryOptions.Types.Where(t => t.Value == p.ItemType).Select(t => t.Label).FirstOrDefault() ?? p.ItemType)</td>
                <td class="num">@p.LoanDays</td>
                <td class="num">@p.DailyOverdueRate.ToString("C")</td>
                <td class="num">@p.OverdueCap.ToString("C")</td>
                <td class="num">@p.DamageFee.ToString("C")</td>
                <td class="num">@p.ReplacementCost.ToString("C")</td>
            </tr>
        }
    </table>
</section>

<p class="report-meta" style="font-size: 13px; color: #5f6b64;">
    Compared with the previous period @Model.PrevFrom.ToString("MMM d, yyyy") – @Model.PrevTo.ToString("MMM d, yyyy").
    A loan is late if it was returned after its due date or is still out past it. "Items overdue right now" is not limited to the date range; fine so far = days overdue × daily rate, up to the category's cap.
    Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt").
</p>
