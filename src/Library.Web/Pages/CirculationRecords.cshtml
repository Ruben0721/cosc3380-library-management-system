@page
@model Project.Pages.CirculationRecordsModel
@{
    ViewData["Title"] = "Supporting records – Circulation & Collection Performance";
    var from = Model.From?.ToString("yyyy-MM-dd");
    var to = Model.To?.ToString("yyyy-MM-dd");
    var tabs = new[] { ("checkouts", "Checkouts"), ("copies", "Copies"), ("holds", "Holds"), ("borrowers", "Borrowers") };
}

<div class="report-header">
    <div>
        <p class="eyebrow">Supporting records · Circulation &amp; Collection Performance</p>
        <h1>@Model.Table.Title</h1>
        <p class="report-lede">@Model.Table.Description</p>
        <p class="report-meta">@string.Join(" · ", Model.Narrowing)</p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-library-outline" asp-page="/CirculationRecords" asp-page-handler="Csv" asp-all-route-data="Model.RouteValues()">Download CSV</a>
        <a class="btn btn-outline-secondary" asp-page="/CollectionPerformance" asp-route-From="@from" asp-route-To="@to"
           asp-route-Category="@Model.Category">Back to report</a>
    </div>
</div>

<div class="records-tabs no-print" role="navigation" aria-label="Record type">
    @foreach (var (key, label) in tabs)
    {
        <a class="@(Model.Show == key ? "active" : "")" asp-page="/CirculationRecords" asp-route-Show="@key"
           asp-route-From="@from" asp-route-To="@to" asp-route-Category="@Model.Category">@label</a>
    }
</div>

<partial name="_RecordTable" model="Model.Table" />
