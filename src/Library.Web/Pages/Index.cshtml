@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Library | Home</title>

</head>

<body>
    <header>
        <div class="header-content">
            <a class="brand" asp-page="/Index">Campus Library</a>

            <nav aria-label="Main navigation">
                <a asp-page="/Index" aria-current="page">Home</a>
                <a asp-page="/Search">Library Catalog</a>
                <a href="#about">About</a>
                <a asp-page="/Account/Login">Log In</a>
                <a class="signup-link" asp-page="/Account/Register">Sign Up</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="hero" aria-labelledby="welcome-heading">
            <p class="eyebrow">For students and staff</p>

            <h1 id="welcome-heading">
                A place to learn.<br>
                A world to discover.
            </h1>

            <p class="hero-description">
                Find your next great read, explore resources for your
                coursework, or settle into a quiet space to study.
                Your campus library is here to support you.
            </p>

            <div class="actions">
                <a class="button button-primary" asp-page="/Search">
                    Browse the Collection
                </a>

                <a class="button" href="#visit">
                    Plan Your Visit
                </a>
            </div>
        </section>

        <section id="about" class="overview">
            <h2>Your library, your community.</h2>

            <p>
                Campus Library brings students and staff together through
                books, learning, and discovery. Whether you are researching
                an assignment, preparing a lesson, or reading for enjoyment,
                we offer a welcoming place to explore new ideas.
            </p>
        </section>

        <section aria-labelledby="services-heading">
            <p class="eyebrow">Explore our services</p>
            <h2 id="services-heading">More than a collection of books.</h2>

            <div class="cards">
                <article class="card">
                    <h3>Books &amp; Resources</h3>
                    <p>
                        Explore academic titles, literature, and books
                        across a variety of subjects. Browse the catalog
                        to see what is available.
                    </p>
                </article>

                <article class="card">
                    <h3>Spaces to Study</h3>
                    <p>
                        Find room to focus, review your notes, or work
                        through your next assignment in a comfortable
                        learning environment.
                    </p>
                </article>

                <article class="card">
                    <h3>Research Support</h3>
                    <p>
                        Ask library staff for help finding books,
                        exploring subjects, and locating resources
                        for your studies or teaching.
                    </p>
                </article>
            </div>
        </section>

        <section id="visit" aria-labelledby="visit-heading">
            <p class="eyebrow">Stop by</p>
            <h2 id="visit-heading">Make time for your library.</h2>

            <div class="visit-grid">
                <div>
                    <h3>Library Hours</h3>

                    <table class="hours">
                        <caption>Sample regular opening hours</caption>
                        <tbody>
                            <tr>
                                <th scope="row">Monday–Thursday</th>
                                <td>8:00 AM–8:00 PM</td>
                            </tr>
                            <tr>
                                <th scope="row">Friday</th>
                                <td>8:00 AM–5:00 PM</td>
                            </tr>
                            <tr>
                                <th scope="row">Saturday</th>
                                <td>10:00 AM–4:00 PM</td>
                            </tr>
                            <tr>
                                <th scope="row">Sunday</th>
                                <td>Closed</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div>
                    <h3>Visiting &amp; Borrowing</h3>
                    <p>
                        Students and staff are welcome to explore our
                        collection and use our study spaces.
                    </p>
                    <p>
                        Bring your campus identification when visiting
                        the circulation desk to borrow materials.
                    </p>
                </div>
            </div>
        </section>

    </main>

    <footer>
        <p><strong>Campus Library</strong></p>
        <p>A fictional campus library · Student team project</p>
    </footer>
</body>
</html>