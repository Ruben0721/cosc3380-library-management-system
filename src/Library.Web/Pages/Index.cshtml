@page
@{
    Layout = null;

    const string SearchTextParam = "SearchTerm";
    const string CategoryParam = "SelectedType";

    var categories = new[]
    {
        ("book", "Books", "Textbooks, literature and reference"),
        ("laptop", "Laptops", "Borrow a laptop for coursework"),
        ("headphones", "Headphones", "For media and quiet study"),
        ("media", "Media", "Films, music and audio"),
        ("map", "Maps", "Regional and historical maps")
    };

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Library | Home</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
</head>

<body>
    <header>
        <div class="header-content">
            <a class="brand" asp-page="/Index">Campus Library</a>

            <nav aria-label="Main navigation">
                <a asp-page="/Index" aria-current="page">Home</a>
                <a asp-page="/Search">Library Catalog</a>
                <a asp-page="/Rooms">Rooms</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Account/MyLibrary">My Library Account</a>

                    @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                    {
                        <a asp-page="/Staff/Index">Staff Dashboard</a>
                    }

                    <span>Signed in as @User.Identity.Name</span>
                    <a class="signup-link" asp-page="/Account/Logout">Log Out</a>
                }
                else
                {
                    <a asp-page="/Account/Login">Log In</a>
                    <a class="signup-link" asp-page="/Account/Register">Sign Up</a>
                }
            </nav>
        </div>
    </header>

    <main>
        <!-- Search first: it's what most visitors came to do -->
        <section class="hero home-hero" aria-labelledby="welcome-heading">
            <p class="eyebrow">For students, faculty and staff</p>
            <h1 id="welcome-heading">Find it, request it, pick it up.</h1>
            <p class="hero-description">
                Search books, laptops, media and more. Request what's on the shelf, place a hold on what's out,
                and collect it at the circulation desk.
            </p>

            <form class="home-search" method="get" asp-page="/Search" role="search">
                <label for="home-search-input" class="visually-hidden">Search the catalog</label>
                <input id="home-search-input" type="search" name="@SearchTextParam"
                       placeholder="Search by title, author or item" autocomplete="off">
                <button type="submit" class="button button-primary">Search</button>
            </form>

            <p class="home-quick">
                <a asp-page="/Search">Browse the full catalog</a>
                <a asp-page="/Rooms">Reserve a study room</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Account/MyLibrary">My library account</a>
                }
                else
                {
                    <a asp-page="/Account/Login">Sign in to borrow</a>
                }
            </p>
        </section>

        <section aria-labelledby="browse-heading">
            <h2 id="browse-heading">Browse by category</h2>
            <div class="home-categories">
                @foreach (var (value, label, note) in categories)
                {
                    <a class="home-category" href="/Search?@CategoryParam=@value">
                        <span class="home-category-name">@label</span>
                        <span class="home-category-note">@note</span>
                    </a>
                }
            </div>
        </section>

        <section aria-labelledby="how-heading">
            <h2 id="how-heading">How borrowing works</h2>
            <ol class="home-steps">
                <li>
                    <h3>Find an item</h3>
                    <p>Search the catalog or browse a category to see what's available.</p>
                </li>
                <li>
                    <h3>Request or hold it</h3>
                    <p>Request it if a copy is on the shelf. If every copy is out, place a hold and join the line.</p>
                </li>
                <li>
                    <h3>Pick it up</h3>
                    <p>We set it aside at the circulation desk. Collect it within 2 days. Your loan starts at pickup.</p>
                </li>
            </ol>
        </section>

        <section aria-labelledby="rules-heading">
            <h2 id="rules-heading">Good to know</h2>
            <ul class="home-facts">
                <li><strong>Borrowing limits</strong><span>Students 5 items at a time, faculty 10.</span></li>
                <li><strong>Pickup window</strong><span>Requested items are held at the circulation desk for 2 days.</span></li>
                <li><strong>Fines</strong><span>Pay online from your account or at the desk.</span></li>
                <li><strong>Study rooms</strong><span>Reserve online. See <a asp-page="/Rooms">room availability</a>.</span></li>
            </ul>
        </section>
    </main>

    <footer>
        <p><strong>Campus Library</strong></p>
        <p>COSC 3380 · Team 2</p>
    </footer>
</body>

</html>
