@page
@model Project.Pages.ReadingListModel
@{
    ViewData["Title"] = "My reading list";
}

<div class="report-header">
    <div>
        <p class="eyebrow">My library</p>
        <h1>My reading list</h1>
        <p class="report-lede">Titles you saved. See which are on the shelf, request them, or hold the ones that are out.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-library-outline" asp-page="/Search">Browse the catalog</a>
        <a class="btn btn-outline-secondary" asp-page="/Account/MyLibrary">My library account</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.SignedIn)
{
    <p>Sign in with a student or faculty account to keep a reading list.</p>
    <a class="btn btn-library" asp-page="/Account/Login" asp-route-ReturnUrl="/ReadingList">Sign in</a>
}
else if (Model.Rows.Count == 0)
{
    <p>Your reading list is empty. Open any title in the <a asp-page="/Search">catalog</a> and choose <strong>Save to reading list</strong>.</p>
}
else
{
    <table class="results">
        <tr><th>Title</th><th>Category</th><th>Saved</th><th>Status for you</th><th class="num"></th></tr>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a asp-page="/Borrow" asp-route-ItemId="@r.ItemId">@r.Title</a></td>
                <td>@r.Category</td>
                <td>@r.Added.ToString("MMM d")</td>
                <td><span class="pill @(r.Highlight ? "pill-ok" : "pill-off")">@r.Availability</span></td>
                <td class="num">
                    <div class="d-inline-flex gap-2">
                        <a class="btn btn-sm @(r.Action == "View" ? "btn-outline-secondary" : "btn-library")" asp-page="/Borrow" asp-route-ItemId="@r.ItemId">@r.Action</a>
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="itemId" value="@r.ItemId" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Remove @r.Title">Remove</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </table>
}
