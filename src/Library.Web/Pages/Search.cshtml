@page
@model SearchModel
@{
    ViewData["Title"] = "Library Catalog";
}
<section class="report-header">
    <div>
        <p class="eyebrow">Books &amp; resources</p>
        <h1>Library Catalog</h1>
        <p class="report-lede">Find books, media, equipment, and maps in the collection.</p>
    </div>
</section>

<form method="get" class="overview mb-4">
    <label for="SelectedType">Item type</label>
    <select id="SelectedType" asp-for="SelectedType" class="form-select mb-2">
        <option value="">All items</option>
        @foreach (var t in Model.Types)
        {
            <option value="@t.Value">@t.Label</option>
        }
    </select>
    <label for="SearchTerm">Search the catalog</label>
    <input id="SearchTerm" asp-for="SearchTerm" class="form-control mb-2"
           placeholder="Name, author, ISBN, or other item details" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-page="/Search" class="btn btn-outline-secondary">Show all items</a>
</form>

@if (Model.Results.Count == 0)
{
    <p class="alert alert-light border" role="status">No items found. Try another search or choose a different item type.</p>
}
else
{
    <p role="status">@Model.Results.Count items found</p>
    <div class="table-responsive">
        <table class="results mt-2">
            <thead>
                <tr><th scope="col">Type</th><th scope="col">Name</th><th scope="col">Details</th><th scope="col">Status</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.Type</td>
                    <td><a asp-page="/ItemDetails" asp-route-id="@item.Id">@item.Name</a></td>
                    <td>@item.DetailsSummary()</td>
                    <td><span class="pill @(item.Status == "Available" ? "pill-ok" : "pill-off")">@item.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
