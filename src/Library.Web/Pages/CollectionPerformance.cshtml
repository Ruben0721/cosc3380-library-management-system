@page
@model Project.Pages.CollectionPerformanceModel

@{
    ViewData["Title"] = "Circulation & Collection Performance";
    double change = Model.PrevCheckouts == 0 ? 0
        : 100.0 * (Model.TotalCheckouts - Model.PrevCheckouts) / Model.PrevCheckouts;

    // Links to the supporting records: the report's filters plus what a number was counted from
    Dictionary<string, string> R(params string[] kv)
    {
        var d = new Dictionary<string, string>();
        if (Model.From != null) d["From"] = Model.From.Value.ToString("yyyy-MM-dd");
        if (Model.To != null) d["To"] = Model.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(Model.Category)) d["Category"] = Model.Category;
        for (int i = 0; i + 1 < kv.Length; i += 2)
        {
            if (string.IsNullOrEmpty(kv[i + 1])) d.Remove(kv[i]); else d[kv[i]] = kv[i + 1];
        }
        return d;
    }
    string ValueOf(string label) => Model.Types.Where(t => t.Label == label).Select(t => t.Value).FirstOrDefault() ?? label;

    // Message for empty title lists: explain when the demand filter is the reason
    string EmptyMessage(string normal) => string.IsNullOrEmpty(Model.DemandFilter)
        ? normal
        : $"No titles with \"{Model.DemandFilter}\" demand in this section for this period.";
}

<!-- Header -->
<div class="report-header">
    <div>
        <p class="eyebrow">Reports</p>
        <h1>Circulation &amp; Collection Performance</h1>
        <p class="report-lede">Which titles are in demand, which are waitlisted, and which are underused.</p>
        <p class="report-meta">
            @Model.From?.ToString("MMM d, yyyy") – @Model.To?.ToString("MMM d, yyyy")
            · @(string.IsNullOrEmpty(Model.Category) ? "All categories" : Model.Category)
            · @(string.IsNullOrEmpty(Model.DemandFilter) ? "Any demand" : Model.DemandFilter + " demand")
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-library-outline" asp-page="/CirculationRecords" asp-all-route-data='R()'>View all records</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</div>
<p class="report-meta no-print" style="margin-top: -8px;">Click any <span class="drill-num">underlined number</span> to see the records it was counted from.</p>

<!-- Filters -->
<section class="overview no-print">
    <form method="get" class="search-form">
        <label>From <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>

        <select name="Category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var t in Model.Types)
            {
                <option value="@t.Value" selected="@(t.Value == Model.Category)">@t.Label</option>
            }
        </select>

        <select name="DemandFilter" aria-label="Demand">
            <option value="">Any demand</option>
            @foreach (var d in new[] { "High", "Medium", "Low", "Never borrowed" })
            {
                <option value="@d" selected="@(d == Model.DemandFilter)">@d</option>
            }
        </select>

        <button type="submit" class="button button-primary">View Report</button>
    </form>
</section>

@if (!string.IsNullOrEmpty(Model.DemandFilter))
{
    <div class="alert alert-secondary no-print py-2">
        Title lists are filtered to <strong>@Model.DemandFilter</strong> demand.
        <a asp-page="/CollectionPerformance"
           asp-route-From="@Model.From?.ToString("yyyy-MM-dd")"
           asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
           asp-route-Category="@Model.Category">Show all demand levels</a>
    </div>
}

<!-- Headline numbers -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-label">Checkouts</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts")'>@Model.TotalCheckouts</a></div>
        <div class="kpi-note">
            @if (Model.PrevCheckouts > 0)
            {
                <span><strong>@(change >= 0 ? "▲ +" : "▼ ")@change.ToString("0")%</strong> vs. previous period</span>
            }
            else
            {
                <span>no checkouts in previous period</span>
            }
        </div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Unique borrowers</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "borrowers")'>@Model.UniqueBorrowers</a></div>
        <div class="kpi-note">members who borrowed</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Utilization</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies")'>@Model.UtilizationPct.ToString("0")%</a></div>
        <div class="kpi-note">of copies borrowed at least once</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Checkouts per copy</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies")'>@Model.AvgPerItem.ToString("0.00")</a></div>
        <div class="kpi-note">
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <span>library average <strong>@Model.LibraryAvgPerCopy.ToString("0.00")</strong></span>
            }
            else
            {
                <span>across @Model.TotalCopies copies</span>
            }
        </div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Collection</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies")'>@Model.TotalTitles</a></div>
        <div class="kpi-note">titles · @Model.TotalCopies copies</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Waiting for items</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "holds", "Waiting", "true")'>@Model.TotalWaiting</a></div>
        <div class="kpi-note">members on a waitlist now</div>
    </div>
</div>

<!-- Findings -->
<section class="findings">
    <h2>Findings &amp; recommendations</h2>
    <ol>
        @foreach (var r in Model.Recommendations)
        {
            <li>@r</li>
        }
    </ol>
</section>

<!-- Performance by category -->
<section class="report-section">
    <h2>Performance by category</h2>
    <table class="results">
        <tr>
            <th>Category</th><th class="num">Copies</th><th class="num">Available</th>
            <th class="num">Under repair</th><th class="num">Checkouts</th>
            <th class="num">Per copy</th><th class="num">Never borrowed</th>
            <th class="num">vs. previous</th><th>Demand</th>
        </tr>
        @foreach (var c in Model.Categories)
        {
            double? catChange = c.PrevCheckouts == 0 ? null : 100.0 * (c.Checkouts - c.PrevCheckouts) / c.PrevCheckouts;
            <tr>
                <td>@c.Label</td>
                <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", c.Category)'>@c.Items</a></td>
                <td class="num">@c.Available</td>
                <td class="num">@c.UnderRepair</td>
                <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts", "Category", c.Category)'>@c.Checkouts</a></td>
                <td class="num">@c.PerItem.ToString("0.00")</td>
                <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", c.Category, "Unborrowed", "true")'>@c.NeverPct.ToString("0")%</a></td>
                <td class="num">@(catChange == null ? "—" : (catChange >= 0 ? "+" : "") + catChange.Value.ToString("0") + "%")</td>
                <td><strong>@c.Demand</strong></td>
            </tr>
        }
        <tr class="total">
            <td>Total</td>
            <td class="num">@Model.TotalCopies</td>
            <td class="num">@Model.Categories.Sum(c => c.Available)</td>
            <td class="num">@Model.Categories.Sum(c => c.UnderRepair)</td>
            <td class="num">@Model.TotalCheckouts</td>
            <td class="num">@Model.AvgPerItem.ToString("0.00")</td>
            <td class="num">@((100 - Model.UtilizationPct).ToString("0"))%</td>
            <td class="num">@(Model.PrevCheckouts == 0 ? "—" : (change >= 0 ? "+" : "") + change.ToString("0") + "%")</td>
            <td></td>
        </tr>
    </table>
</section>

<!-- Monthly trend -->
<section class="report-section">
    <h2>Monthly checkouts</h2>
    <table class="results">
        <tr>
            <th>Category</th>
            @foreach (var m in Model.Months)
            {
                <th class="num">@DateTime.Parse(m + "-01").ToString("MMM yyyy")</th>
            }
        </tr>
        @foreach (var row in Model.Trend)
        {
            <tr>
                <td>@row.Key</td>
                @foreach (var m in Model.Months)
                {
                    <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts", "Category", ValueOf(row.Key), "Month", m)'>@row.Value[m]</a></td>
                }
            </tr>
        }
        <tr class="total">
            <td>Total</td>
            @foreach (var m in Model.Months)
            {
                <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts", "Month", m)'>@Model.Trend.Values.Sum(v => v[m])</a></td>
            }
        </tr>
    </table>
</section>

<!-- Most in demand + most waitlisted side by side -->
<div class="report-grid-2">
    <section class="report-section">
        <h2>Most in-demand titles</h2>
        @if (Model.TopTitles.Count == 0)
        {
            <p>@EmptyMessage("No checkouts in this period.")</p>
        }
        else
        {
            <table class="results">
                <tr><th>Title</th><th class="num">Copies</th><th class="num">Checkouts</th><th class="num">Per copy</th><th class="num">Waiting</th></tr>
                @foreach (var t in Model.TopTitles)
                {
                    <tr>
                        <td><a asp-page="/Search" asp-route-SearchTerm="@t.Title">@t.Title</a><br /><small class="text-muted">@t.Category · @t.Demand</small></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Copies</a></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Checkouts</a></td>
                        <td class="num">@t.PerCopy.ToString("0.0")</td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "holds", "Waiting", "true", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Waiting</a></td>
                    </tr>
                }
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Most waitlisted titles</h2>
        @if (Model.MostWaitlisted.Count == 0)
        {
            <p>@EmptyMessage("No holds placed in this period.")</p>
        }
        else
        {
            <table class="results">
                <tr><th>Title</th><th class="num">Copies</th><th class="num">Available</th><th class="num">Holds</th><th class="num">Waiting</th></tr>
                @foreach (var t in Model.MostWaitlisted)
                {
                    <tr>
                        <td><a asp-page="/Search" asp-route-SearchTerm="@t.Title">@t.Title</a><br /><small class="text-muted">@t.Category</small></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Copies</a></td>
                        <td class="num">@t.Available</td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "holds", "InPeriod", "true", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.HoldsInPeriod</a></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "holds", "Waiting", "true", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Waiting</a></td>
                    </tr>
                }
            </table>
        }
    </section>
</div>

<!-- Least borrowed + never borrowed side by side -->
<div class="report-grid-2">
    <section class="report-section">
        <h2>Least borrowed titles</h2>
        @if (Model.LeastBorrowed.Count == 0)
        {
            <p>@EmptyMessage("No checkouts in this period.")</p>
        }
        else
        {
            <table class="results">
                <tr><th>Title</th><th class="num">Copies</th><th class="num">Checkouts</th><th class="num">Per copy</th></tr>
                @foreach (var t in Model.LeastBorrowed)
                {
                    <tr>
                        <td><a asp-page="/Search" asp-route-SearchTerm="@t.Title">@t.Title</a><br /><small class="text-muted">@t.Category · @t.Demand</small></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Copies</a></td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "checkouts", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Checkouts</a></td>
                        <td class="num">@t.PerCopy.ToString("0.0")</td>
                    </tr>
                }
            </table>
        }
    </section>

    <section class="report-section">
        <h2>Not borrowed in this period (@Model.NeverBorrowed.Count)</h2>
        @if (Model.NeverBorrowed.Count == 0)
        {
            <p>@EmptyMessage("Every title was borrowed at least once.")</p>
        }
        else
        {
            <table class="results">
                <tr><th>Title</th><th>Category</th><th class="num">Copies</th><th class="num">Available</th></tr>
                @foreach (var t in Model.NeverBorrowed)
                {
                    <tr>
                        <td><a asp-page="/Search" asp-route-SearchTerm="@t.Title">@t.Title</a></td>
                        <td>@t.Category</td>
                        <td class="num"><a class="drill-num" asp-page="/CirculationRecords" asp-all-route-data='R("Show", "copies", "Category", ValueOf(t.Category), "Title", t.Title)'>@t.Copies</a></td>
                        <td class="num">@t.Available</td>
                    </tr>
                }
            </table>
        }
    </section>
</div>

<p class="report-meta" style="font-size: 13px; color: #5f6b64;">
    Compared with the previous period @Model.PrevFrom.ToString("MMM d, yyyy") – @Model.PrevTo.ToString("MMM d, yyyy"). Demand is based on checkouts per copy compared with the library average.
    Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt").
</p>
