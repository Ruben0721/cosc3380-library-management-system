@page
@model Project.Pages.EquipmentMaintenanceModel
@using Project.Configuration

@{
    ViewData["Title"] = "Equipment Maintenance";
    int replaceCount = Model.ItemReliability.Count(r => r.Recommendation == "Replace");
    decimal replaceBudget = Model.ItemReliability.Where(r => r.Recommendation == "Replace").Sum(r => r.ReplacementCost ?? 0);
    double inServicePct = Model.ItemsTracked == 0 ? 0 : 100.0 * (Model.ItemsTracked - Model.OutOfServiceNow) / Model.ItemsTracked;
    int reqChange = Model.RequestsOpened - Model.PrevRequestsOpened;
    // Links to the supporting records: the report's filters plus what a number was counted from
    Dictionary<string, string> R(params string[] kv)
    {
        var d = new Dictionary<string, string>();
        if (Model.From != null) d["From"] = Model.From.Value.ToString("yyyy-MM-dd");
        if (Model.To != null) d["To"] = Model.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(Model.Category)) d["Category"] = Model.Category;
        if (!string.IsNullOrEmpty(Model.RequestType)) d["RequestType"] = Model.RequestType;
        for (int i = 0; i + 1 < kv.Length; i += 2)
        {
            if (string.IsNullOrEmpty(kv[i + 1])) d.Remove(kv[i]); else d[kv[i]] = kv[i + 1];
        }
        return d;
    }
    string ValueOf(string label) => LibraryOptions.Types.Where(t => t.Label == label).Select(t => t.Value).FirstOrDefault() ?? label;
    string Ym(string monthLabel) => DateTime.TryParseExact(monthLabel, "MMM yyyy", System.Globalization.CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out var md) ? md.ToString("yyyy-MM") : "";
    string categoryLabel = string.IsNullOrEmpty(Model.Category) ? "All categories"
        : LibraryOptions.Types.Where(t => t.Value == Model.Category).Select(t => t.Label).FirstOrDefault() ?? Model.Category;
}

<!-- Header -->
<div class="report-header">
    <div>
        <p class="eyebrow">Reports</p>
        <h1>Equipment Maintenance</h1>
        <p class="report-lede">What is breaking, how fast it gets fixed, what is out of service, and which items should be replaced.</p>
        <p class="report-meta">
            @Model.From?.ToString("MMM d, yyyy") – @Model.To?.ToString("MMM d, yyyy")
            · @categoryLabel
            · @(string.IsNullOrEmpty(Model.RequestType) ? "All request types" : Model.RequestType)
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-library-outline" asp-page="/MaintenanceRecords" asp-all-route-data='R()'>View all records</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>
</div>
<p class="report-meta no-print" style="margin-top: -8px;">Click any <span class="drill-num">underlined number</span> or item name to see the records behind it.</p>

<!-- Filters -->
<section class="overview no-print">
    <form method="get" class="search-form">
        <label>From <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>To <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>

        <select name="Category" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var t in LibraryOptions.Types)
            {
                <option value="@t.Value" selected="@(t.Value == Model.Category)">@t.Label</option>
            }
        </select>

        <select name="RequestType" aria-label="Request type">
            <option value="">All request types</option>
            @foreach (var r in Project.Pages.EquipmentMaintenanceModel.RequestTypes)
            {
                <option value="@r" selected="@(r == Model.RequestType)">@r</option>
            }
        </select>

        <button type="submit" class="button button-primary">View Report</button>
    </form>
</section>

<!-- Headline numbers -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-label">In service</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "items", "State", "out")'>@inServicePct.ToString("0")%</a></div>
        <div class="kpi-note"><strong>@Model.OutOfServiceNow</strong> of @Model.ItemsTracked items out of service</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Open requests</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Scope", "open")'>@Model.OpenNow</a></div>
        <div class="kpi-note">@(Model.OpenNow == 0 ? "Nothing waiting" : $"oldest open {Model.OldestOpenDays} days")</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Requests opened</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests")'>@Model.RequestsOpened</a></div>
        <div class="kpi-note">
            @if (Model.PrevRequestsOpened > 0)
            {
                <span><strong>@(reqChange >= 0 ? "▲ +" : "▼ ")@reqChange</strong> vs. previous period</span>
            }
            else
            {
                <span>@Model.RequestsResolved resolved this period</span>
            }
        </div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Avg days to resolve</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Scope", "resolved")'>@(Model.AvgDaysToResolve == null ? "—" : Model.AvgDaysToResolve.Value.ToString("0.0"))</a></div>
        <div class="kpi-note">@Model.RequestsResolved requests resolved</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Damage rate</div>
        <div class="kpi-value"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "returns")'>@Model.DamageRate.ToString("0.0")%</a></div>
        <div class="kpi-note">@Model.DamagedReturns of @Model.ReturnsInPeriod returns damaged</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Recommended replacements</div>
        <div class="kpi-value"><a class="drill-num" href="#repair-or-replace">@replaceCount</a></div>
        <div class="kpi-note">@(replaceCount == 0 ? "No replacements needed" : $"est. {replaceBudget:C} budget")</div>
    </div>
</div>

<!-- Findings -->
<section class="findings">
    <h2>Findings &amp; recommendations</h2>
    <ol>
        @foreach (var r in Model.Recommendations)
        {
            <li>@r</li>
        }
    </ol>
</section>

<!-- Open work queue -->
<section class="report-section">
    <h2 class="section-title">Open maintenance requests (@Model.OpenQueue.Count) <a class="section-link no-print" asp-page="/Staff/Maintenance">Work on these requests →</a></h2>
    @if (Model.OpenQueue.Count == 0)
    {
        <p>No open maintenance requests.</p>
    }
    else
    {
        <table class="results">
            <tr>
                <th class="num">#</th><th>Item</th><th>Category</th><th>Request</th><th>Reason</th>
                <th>Status</th><th>Opened</th><th class="num">Days open</th><th>Item status</th><th>Last borrower</th>
            </tr>
            @foreach (var o in Model.OpenQueue)
            {
                <tr>
                    <td class="num">@o.RequestId</td>
                    <td><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "item", "ItemId", o.ItemId.ToString())'>@o.ItemName</a></td>
                    <td>@o.Category</td>
                    <td><strong>@o.RequestType</strong></td>
                    <td>@o.Reason</td>
                    <td>@o.Status</td>
                    <td>@o.CreatedAt.ToString("MMM d, yyyy")</td>
                    <td class="num">@o.DaysOpen</td>
                    <td>@o.ItemStatus</td>
                    <td>@(o.LastBorrower ?? "—")</td>
                </tr>
            }
        </table>
    }
</section>

<!-- Repair or replace -->
<section class="report-section">
    <h2 id="repair-or-replace">Repair or replace</h2>
    @if (Model.ItemReliability.Count == 0)
    {
        <p>No items have been returned damaged.</p>
    }
    else
    {
        <table class="results">
            <tr>
                <th>Item</th><th>Category</th><th>Status</th><th class="num">Loans</th>
                <th class="num">Repairs (180 days)</th><th class="num">Repairs (all)</th>
                <th class="num">Damage per loan</th><th class="num">Fees assessed</th>
                <th class="num">Replacement cost</th><th>Recommendation</th><th>Why</th>
            </tr>
            @foreach (var r in Model.ItemReliability)
            {
                <tr>
                    <td><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "item", "ItemId", r.ItemId.ToString())'>@r.ItemName</a></td>
                    <td>@r.Category</td>
                    <td>@r.ItemStatus</td>
                    <td class="num">@r.Loans</td>
                    <td class="num">@r.DamageRepairs180</td>
                    <td class="num">@r.DamageRepairsTotal</td>
                    <td class="num">@r.DamageRate.ToString("0")%</td>
                    <td class="num">@r.FeesAssessed.ToString("C")</td>
                    <td class="num">@(r.ReplacementCost == null ? "—" : r.ReplacementCost.Value.ToString("C"))</td>
                    <td><strong>@r.Recommendation</strong></td>
                    <td>@r.Why</td>
                </tr>
            }
        </table>
    }
</section>

<!-- Monthly activity -->
<section class="report-section">
    <h2>Monthly activity</h2>
    <table class="results">
        <tr>
            <th>Month</th><th class="num">Repairs</th><th class="num">Inspections</th>
            <th class="num">Reviews</th><th class="num">Resolved</th>
        </tr>
        @foreach (var m in Model.Monthly)
        {
            <tr>
                <td>@m.Month</td>
                <td class="num"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Month", Ym(m.Month), "RequestType", "Damage Repair")'>@m.DamageRepairs</a></td>
                <td class="num"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Month", Ym(m.Month), "RequestType", "Routine Inspection")'>@m.Inspections</a></td>
                <td class="num"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Month", Ym(m.Month), "RequestType", "Replacement Review")'>@m.ReplacementReviews</a></td>
                <td class="num"><a class="drill-num" asp-page="/MaintenanceRecords" asp-all-route-data='R("Show", "requests", "Scope", "resolved", "Month", Ym(m.Month))'>@m.Resolved</a></td>
            </tr>
        }
        <tr class="total">
            <td>Total</td>
            <td class="num">@Model.Monthly.Sum(m => m.DamageRepairs)</td>
            <td class="num">@Model.Monthly.Sum(m => m.Inspections)</td>
            <td class="num">@Model.Monthly.Sum(m => m.ReplacementReviews)</td>
            <td class="num">@Model.Monthly.Sum(m => m.Resolved)</td>
        </tr>
    </table>
</section>

<p class="report-meta" style="font-size: 13px; color: #5f6b64;">
    Compared with the previous period @Model.PrevFrom.ToString("MMM d, yyyy") – @Model.PrevTo.ToString("MMM d, yyyy").
    Requests are created automatically when an item is returned damaged, reaches its inspection interval,
    or has 3 or more damage repairs in 180 days. The routine inspection list is on the <a asp-page="/Staff/Maintenance">Maintenance</a> page. Recommendation: Replace = 3+ repairs in 180 days, an open replacement review, damage fees at or above the replacement cost, or lost; Monitor = 2 repairs in 180 days. Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt").
</p>
