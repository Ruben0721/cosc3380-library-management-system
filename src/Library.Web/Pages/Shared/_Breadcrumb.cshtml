
@{
    var pages = new Dictionary<string, (string Title, string? Parent)>(StringComparer.OrdinalIgnoreCase)
    {
        // Inventory
        ["/Inventory"]             = ("Inventory", null),
        ["/AddInventoryItem"]      = ("Add / Edit Item", "/Inventory"),

        // Members
        ["/Staff/Users"]           = ("Manage Users", null),
        ["/Staff/Directory"]       = ("Staff & Faculty Directory", "/Staff/Users"),
        ["/Staff/ManagePerson"]    = ("Person", "/Staff/Directory"),
        ["/BorrowerRentals"]       = ("Rental History", "/Staff/Users"),

        // Circulation & equipment
        ["/Staff/StartCheckout"]   = ("Check Out", null),
        ["/Checkout"]              = ("Choose Borrower", "/Staff/StartCheckout"),
        ["/CheckoutActivity"]      = ("Checkout Activity", null),
        ["/Staff/Returns"]         = ("Return an Item", null),
        ["/Staff/Fines"]           = ("Fines & Payments", null),
        ["/Staff/Maintenance"]     = ("Maintenance Requests", null),

        // Reports
        ["/CollectionPerformance"] = ("Circulation & Collection Performance", null),
        ["/OverdueFines"]          = ("Overdue Returns & Fines", null),
        ["/EquipmentMaintenance"]  = ("Equipment Maintenance", null),
    };

    var current = ViewContext.RouteData.Values["page"] as string;
    string? parentPage = null;
    string parentTitle = "Staff Dashboard";
    bool show = current != null && pages.TryGetValue(current, out var entry) && Set(entry.Parent);

    bool Set(string? parent)
    {
        if (parent != null && pages.TryGetValue(parent, out var p))
        {
            parentPage = parent;
            parentTitle = p.Title;
        }
        return true;
    }
}

@if (show)
{
    <div class="crumbs no-print" role="navigation" aria-label="Back">
        <a class="back-link" asp-page="@(parentPage ?? "/Staff/Index")">&larr; @parentTitle</a>
    </div>
}
