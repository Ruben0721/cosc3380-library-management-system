@using Microsoft.EntityFrameworkCore
@inject Project.Data.LibraryDbContext Db
@{
    string? firstName = null;
    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirst("library_user_id")?.Value, out var borrowerId))
    {
        firstName = await Db.LibraryUsers.AsNoTracking()
            .Where(u => u.LibraryUserId == borrowerId)
            .Select(u => u.FirstName)
            .FirstOrDefaultAsync();
    }
}
@(string.IsNullOrWhiteSpace(firstName) ? "Hi there" : $"Hi, {firstName.Trim()}")
