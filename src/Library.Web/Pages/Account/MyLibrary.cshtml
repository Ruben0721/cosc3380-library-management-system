@page
@model Project.Pages.Account.MyLibraryModel
@using System.Globalization
@{
    ViewData["Title"] = "My Library Account";
    var dollars = CultureInfo.GetCultureInfo("en-US");
}

<section class="report-header">
    <div>
        <p class="eyebrow">Account overview</p>
        <h1>My Library Account</h1>
        <p class="report-lede">
            @if (Model.FullName != null)
            {
                <strong>@Model.FullName</strong> <span aria-hidden="true">·</span>
            }
            @Model.Email <span aria-hidden="true">·</span> @Model.Role
        </p>
    </div>
    <a class="btn btn-library-outline" asp-page="/Account/ChangePassword">Change password</a>
</section>

@if (Model.FullName == null)
{
    <p class="alert alert-warning">Contact library staff to link your borrower record and view your library activity.</p>
}
else
{
    <div class="kpi-grid" aria-label="Your account at a glance">
        <a class="kpi kpi-link" href="#loans">
            <div class="kpi-label">Items checked out</div>
            <div class="kpi-value">@Model.Loans.Count</div>
        </a>
        <a class="kpi kpi-link" href="#holds">
            <div class="kpi-label">Active holds</div>
            <div class="kpi-value">@Model.Holds.Count</div>
        </a>
        <a class="kpi kpi-link" href="#fines">
            <div class="kpi-label">Fines due</div>
            <div class="kpi-value">@Model.TotalDue.ToString("C", dollars)</div>
        </a>
    </div>

    <section class="account-section" id="loans" aria-labelledby="loans-heading">
        <div class="section-title">
            <h2 id="loans-heading" class="h4">Items checked out</h2>
            <a class="section-link" asp-page="/Search">Browse catalog</a>
        </div>
        @if (Model.Loans.Count == 0)
        {
            <p>You have no items checked out.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead><tr><th>Item</th><th>Due date</th></tr></thead>
                    <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        <tr><td>@(loan.Item ?? "Item name unavailable")</td>
                            <td>@(loan.Due?.ToString("MMM d, yyyy") ?? "No due date")
                                @if (loan.Due < DateTime.Today)
                                {
                                    <span class="pill pill-warn ms-2">Overdue</span>
                                }
                            </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="account-section" id="holds" aria-labelledby="holds-heading">
        <h2 id="holds-heading" class="h4">Requested holds</h2>
        @if (Model.Holds.Count == 0)
        {
            <p>You have no active holds.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead><tr><th>Item</th><th>Status</th><th>Pickup deadline</th></tr></thead>
                    <tbody>
                    @foreach (var hold in Model.Holds)
                    {
                        <tr><td>@(hold.Item ?? "Item name unavailable")</td>
                            <td>@(hold.Status == "Ready" ? "Ready for pickup" : hold.Status)</td>
                            <td>@(hold.Deadline?.ToString("MMM d, yyyy") ?? "—")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="account-section" aria-labelledby="rooms-heading">
        <div class="section-title">
            <h2 id="rooms-heading" class="h4">Room reservations</h2>
            <a class="section-link" asp-page="/RoomReservations">Reserve a room</a>
        </div>
        @if (Model.RoomReservations.Count == 0)
        {
            <p>You have no room reservations.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Room</th>
                            <th>When</th>
                            <th>People</th>
                            <th>Purpose</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var reservation in Model.RoomReservations)
                    {
                        <tr>
                            <td>@reservation.RoomId</td>
                            <td>
                                @reservation.StartTime.ToString("MMM d, yyyy h:mm tt")<br />
                                to @reservation.EndTime.ToString("h:mm tt")
                            </td>
                            <td>@reservation.NumberOfPeople</td>
                            <td>@reservation.Purpose</td>
                            <td>@reservation.Status</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="account-section" id="fines" aria-labelledby="fines-heading">
        <h2 id="fines-heading" class="h4">Fines due</h2>
        @if (Model.Fines.Count == 0)
        {
            <p>You have no unpaid fines.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead><tr><th>Item</th><th>Reason</th><th>Amount</th></tr></thead>
                    <tbody>
                    @foreach (var fine in Model.Fines)
                    {
                        <tr><td>@(fine.Item ?? "Item name unavailable")</td><td>@fine.Reason</td>
                            <td>@fine.Amount.ToString("C", dollars)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
