@page
@model Project.Pages.Staff.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

@if (Model.AccountRole == "Student")
{
    <a asp-page="/Staff/Users">Back to User Management</a>
}
else
{
    <a asp-page="/Staff/Directory">Back to Staff &amp; Faculty Directory</a>
}
<h1 class="mt-3">Reset Password</h1>
<p>Account: <strong>@Model.AccountEmail</strong> (@Model.AccountRole)</p>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

<p>Set a new password for this account. Its previous password will stop working,
    and existing sessions will end on their next request.</p>

<form method="post" asp-page="/Staff/ResetPassword">
    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="ExpectedSessionVersion" />
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <div class="form-text">Use 12–128 characters.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
    </div>
    <button type="submit" class="btn btn-primary">Reset Password</button>
    <a asp-page="/Staff/Directory" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
