@page
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="mb-4">
    <h1>Staff Dashboard</h1>
    <p class="text-muted">
        Manage library inventory, users, circulation, and reports.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <section class="card h-100 shadow-sm" aria-labelledby="inventory-heading">
            <div class="card-body d-flex flex-column">
                <h2 id="inventory-heading" class="h4 card-title">
                    Inventory Management
                </h2>

                <p class="card-text">
                    View library items and add new inventory.
                </p>

                <div class="mt-auto d-grid gap-2">
                    <a class="btn btn-primary" asp-page="/Inventory">
                        View Inventory
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/AddInventoryItem">
                        Add Item
                    </a>
                </div>
            </div>
        </section>
    </div>

    <div class="col-md-6 col-lg-3">
        <section class="card h-100 shadow-sm" aria-labelledby="users-heading">
            <div class="card-body d-flex flex-column">
                <h2 id="users-heading" class="h4 card-title">
                    User Management
                </h2>

                <p class="card-text">
                    Find borrowers and review their account status.
                </p>

                <div class="mt-auto d-grid">
                    <a class="btn btn-primary" asp-page="/Staff/Users">
                        Manage Users
                    </a>
                </div>
            </div>
        </section>
    </div>

    <div class="col-md-6 col-lg-3">
        <section class="card h-100 shadow-sm" aria-labelledby="circulation-heading">
            <div class="card-body d-flex flex-column">
                <h2 id="circulation-heading" class="h4 card-title">
                    Circulation &amp; Equipment
                </h2>

                <p class="card-text">
                    Check items back in, collect fine payments, and work through repair requests.
                </p>

                <div class="mt-auto d-grid gap-2">
                    <a class="btn btn-primary" asp-page="/Staff/Returns">
                        Return an Item
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/Staff/Fines">
                        Fines &amp; Payments
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/Staff/Maintenance">
                        Maintenance Requests
                    </a>
                </div>
            </div>
        </section>
    </div>

    <div class="col-md-6 col-lg-3">
        <section class="card h-100 shadow-sm" aria-labelledby="reports-heading">
            <div class="card-body d-flex flex-column">
                <h2 id="reports-heading" class="h4 card-title">
                    Queries &amp; Reports
                </h2>

                <p class="card-text">
                    Filter the collection and analyze circulation, late returns, fines, and equipment maintenance.
                </p>

                <div class="mt-auto d-grid gap-2">
                    <a class="btn btn-outline-primary" asp-page="/Report">
                        Collection Report
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/CollectionPerformance">
                        Circulation &amp; Collection Performance
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/OverdueFines">
                        Overdue Returns &amp; Fines
                    </a>

                    <a class="btn btn-outline-primary" asp-page="/EquipmentMaintenance">
                        Equipment Maintenance
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>