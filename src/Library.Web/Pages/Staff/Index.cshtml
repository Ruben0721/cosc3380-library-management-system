@page
@model Project.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="staff-layout">

   
    <aside class="staff-menu" aria-label="Staff menu">
        <p class="staff-menu-title">Circulation</p>
        <a asp-page="/Staff/StartCheckout">Check out</a>
        <a asp-page="/Staff/Returns">Return</a>
        <a asp-page="/Staff/Pickups">Pickups</a>
        <a asp-page="/CheckoutActivity">Checkout activity</a>

        <p class="staff-menu-title">Fines &amp; equipment</p>
        <a asp-page="/Staff/Fines">Fines &amp; payments</a>
        <a asp-page="/Staff/Maintenance">Maintenance</a>

        <p class="staff-menu-title">Rooms</p>
        <a asp-page="/Staff/RoomSetupTasks">Room setup</a>

        <p class="staff-menu-title">Members</p>
        <a asp-page="/Staff/Users">Manage users</a>
        <a asp-page="/Staff/Directory">Staff &amp; faculty</a>

        <p class="staff-menu-title">Collection</p>
        <a asp-page="/Inventory">Inventory</a>
        <a asp-page="/AddInventoryItem">Add an item</a>

        @if (User.IsInRole("Admin"))
        {
            <p class="staff-menu-title">Reports</p>
            <a asp-page="/CollectionPerformance">Circulation &amp; collection</a>
            <a asp-page="/OverdueFines">Overdue returns &amp; fines</a>
            <a asp-page="/EquipmentMaintenance">Equipment maintenance</a>
        }
    </aside>

    <div class="staff-main">
        <div class="report-header">
            <div>
                <p class="eyebrow" id="staff-dashboard-date"></p>
                <h1 id="staff-dashboard-greeting">Staff Dashboard</h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-library" asp-page="/Staff/StartCheckout">Check out</a>
                <a class="btn btn-library" asp-page="/Staff/Returns">Return an item</a>
                <a class="btn btn-library-outline" asp-page="/Staff/Fines">Take a payment</a>
            </div>
        </div>

        <h2 class="dash-heading">Needs attention</h2>
        <div class="attention-grid">
            <a class="attention @(Model.OverdueNow > 0 ? "attention-warn" : "")" asp-page="/Staff/Returns" asp-route-OverdueOnly="true">
                <span class="attention-value">@Model.OverdueNow</span>
                <span class="attention-label">overdue item@(Model.OverdueNow == 1 ? "" : "s")</span>
                <span class="attention-note">
                    @(Model.OverdueNow > 0 ? $"{Model.OverdueAccruing:C} in fines accruing" : "Nothing overdue")
                    @(Model.DueToday > 0 ? $" · {Model.DueToday} due today" : "")
                </span>
            </a>

            <a class="attention @(Model.PickupsWaiting > 0 ? "attention-warn" : "")" asp-page="/Staff/Pickups">
                <span class="attention-value">@Model.PickupsWaiting</span>
                <span class="attention-label">pickup@(Model.PickupsWaiting == 1 ? "" : "s") waiting</span>
                <span class="attention-note">
                    @(Model.PickupsWaiting > 0 ? "Set aside, ready to hand out" : "Nothing to hand out")
                    @(Model.HoldsWaiting > 0 ? $" · {Model.HoldsWaiting} on hold lists" : "")
                </span>
            </a>

            <a class="attention @(Model.BookDropWaiting > 0 ? "attention-warn" : "")" asp-page="/Staff/Returns" asp-route-DropBoxOnly="true">
                <span class="attention-value">@Model.BookDropWaiting</span>
                <span class="attention-label">in the book drop</span>
                <span class="attention-note">@(Model.BookDropWaiting > 0 ? "Check in and inspect" : "Book drop is empty")</span>
            </a>

            <a class="attention @(Model.OpenRoomSetupTasks > 0 ? "attention-warn" : "")" asp-page="/Staff/RoomSetupTasks">
                <span class="attention-value">@Model.OpenRoomSetupTasks</span>
                <span class="attention-label">room setup@(Model.OpenRoomSetupTasks == 1 ? "" : "s")</span>
                <span class="attention-note">
                    @(Model.RoomSetupTasks.Count > 0
                        ? $"Next: {Model.RoomSetupTasks[0].RoomId} on {Model.RoomSetupTasks[0].StartTime:MMM d}"
                        : "No rooms waiting for setup")
                </span>
            </a>

            <a class="attention @(Model.OpenRepairs > 0 ? "attention-warn" : "")" asp-page="/Staff/Maintenance">
                <span class="attention-value">@Model.OpenRepairs</span>
                <span class="attention-label">open repair@(Model.OpenRepairs == 1 ? "" : "s")</span>
                <span class="attention-note">@(Model.OpenRepairs > 0 ? $"Oldest open {Model.OldestRepairDays} days" : "All equipment in service")</span>
            </a>

            <a class="attention" asp-page="/Staff/Fines">
                <span class="attention-value">@Model.UnpaidTotal.ToString("C")</span>
                <span class="attention-label">unpaid fines</span>
                <span class="attention-note">@(Model.UnpaidMembers > 0 ? $"Owed by {Model.UnpaidMembers} member{(Model.UnpaidMembers == 1 ? "" : "s")}" : "All fines paid")</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
     
        const dashboardGreeting = document.getElementById("staff-dashboard-greeting");
        const dashboardDate = document.getElementById("staff-dashboard-date");
        const dashboardDateFormat = new Intl.DateTimeFormat("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
            year: "numeric"
        });

        function updateDashboardHeader() {
            const hour = new Date().getHours();
            let greeting;
            if (hour < 5 || hour >= 21) {
                greeting = "Good Night";
            } else if (hour < 12) {
                greeting = "Good Morning";
            } else if (hour < 17) {
                greeting = "Good Afternoon";
            } else {
                greeting = "Good Evening";
            }
            dashboardGreeting.textContent = greeting;
            dashboardDate.textContent = dashboardDateFormat.format(new Date());
        }

        updateDashboardHeader();
        window.setInterval(updateDashboardHeader, 30_000);
    </script>
}
