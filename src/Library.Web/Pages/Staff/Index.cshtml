@page
@model Project.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<!-- Header -->
<div class="report-header">
    <div>
        <p class="eyebrow" id="staff-dashboard-date"></p>
        <h1 id="staff-dashboard-greeting">Staff Dashboard</h1>
        <p class="report-lede">Here is what needs attention in the library today.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-library" asp-page="/Staff/StartCheckout">Check out</a>
        <a class="btn btn-library" asp-page="/Staff/Returns">Return an item</a>
        <a class="btn btn-library-outline" asp-page="/Staff/Fines">Take a payment</a>
    </div>
</div>

<!-- Today at a glance -->
<h2 class="dash-heading">Today at a glance</h2>
<div class="kpi-grid">
    <a class="kpi kpi-link" asp-page="/Staff/Returns" asp-route-OverdueOnly="true">
        <div class="kpi-label">Overdue now</div>
        <div class="kpi-value">@Model.OverdueNow</div>
        <div class="kpi-note">
            @if (Model.OverdueNow > 0)
            {
                <span class="pill pill-warn">Needs follow-up</span>
                <span class="d-block mt-1"><strong>@Model.OverdueAccruing.ToString("C")</strong> in fines accruing</span>
            }
            else
            {
                <span>Nothing overdue</span>
            }
        </div>
    </a>

    <a class="kpi kpi-link" asp-page="/Staff/Returns">
        <div class="kpi-label">Checked out</div>
        <div class="kpi-value">@Model.CheckedOut</div>
        <div class="kpi-note">@Model.DueToday due back today</div>
    </a>

    <a class="kpi kpi-link" asp-page="/Staff/Fines">
        <div class="kpi-label">Unpaid fines</div>
        <div class="kpi-value">@Model.UnpaidTotal.ToString("C")</div>
        <div class="kpi-note">owed by @Model.UnpaidMembers member@(Model.UnpaidMembers == 1 ? "" : "s")</div>
    </a>

    <a class="kpi kpi-link" asp-page="/Staff/Maintenance">
        <div class="kpi-label">Open repairs</div>
        <div class="kpi-value">@Model.OpenRepairs</div>
        <div class="kpi-note">
            @if (Model.OpenRepairs > 0)
            {
                <span>oldest <strong>@Model.OldestRepairDays days</strong> · @Model.OutOfService out of service</span>
            }
            else
            {
                <span>@Model.OutOfService items out of service</span>
            }
        </div>
    </a>

    <a class="kpi kpi-link" asp-page="/Staff/RoomSetupTasks">
        <div class="kpi-label">Room setup</div>
        <div class="kpi-value">@Model.OpenRoomSetupTasks</div>
        <div class="kpi-note">
            @if (Model.RoomSetupTasks.Count > 0)
            {
                <span>next: <strong>@Model.RoomSetupTasks[0].RoomId</strong> on @Model.RoomSetupTasks[0].StartTime.ToString("MMM d")</span>
            }
            else
            {
                <span>No rooms waiting for setup</span>
            }
        </div>
    </a>

    <div class="kpi">
        <div class="kpi-label">Holds</div>
        <div class="kpi-value">@Model.HoldsWaiting</div>
        <div class="kpi-note">members waiting · <strong>@Model.HoldsReady</strong> ready for pickup</div>
    </div>

    <a class="kpi kpi-link" asp-page="/Staff/Users">
        <div class="kpi-label">Active members</div>
        <div class="kpi-value">@Model.ActiveMembers</div>
        <div class="kpi-note">@Model.MembersWithoutLogin without a website login</div>
    </a>
</div>

<!-- Work areas -->
<h2 class="dash-heading">Work areas</h2>
<div class="dash-grid">
    <section class="dash-card">
        <h3>Circulation</h3>
        <p>Lend and check in items.</p>
        <div class="dash-links" role="navigation" aria-label="Circulation">
            <a asp-page="/Staff/StartCheckout">Check out an item</a>
            <a asp-page="/Staff/Returns">Return an item</a>
            <a asp-page="/CheckoutActivity">Checkout activity</a>
        </div>
    </section>

    <section class="dash-card">
        <h3>Fines &amp; equipment</h3>
        <p>Collect payments and handle repairs.</p>
        <div class="dash-links" role="navigation" aria-label="Fines and equipment">
            <a asp-page="/Staff/Fines">Fines &amp; payments</a>
            <a asp-page="/Staff/Maintenance">Maintenance requests</a>
        </div>
    </section>

    <section class="dash-card">
        <h3>Collection</h3>
        <p>Manage the library's items.</p>
        <div class="dash-links" role="navigation" aria-label="Collection">
            <a asp-page="/Inventory">View inventory</a>
            <a asp-page="/AddInventoryItem">Add an item</a>
        </div>
    </section>

    <section class="dash-card">
        <h3>Members</h3>
        <p>Borrowers, staff and faculty.</p>
        <div class="dash-links" role="navigation" aria-label="Members">
            <a asp-page="/Staff/Users">Manage users</a>
            <a asp-page="/Staff/Directory">Staff &amp; faculty directory</a>
        </div>
    </section>

    <section class="dash-card">
        <h3>Reports</h3>
        <p>Analysis to support decisions.</p>
        <div class="dash-links" role="navigation" aria-label="Reports">
            <a asp-page="/CollectionPerformance">Circulation &amp; collection performance</a>
            <a asp-page="/OverdueFines">Overdue returns &amp; fines</a>
            <a asp-page="/EquipmentMaintenance">Equipment maintenance</a>
        </div>
    </section>
</div>

<!-- Recent activity -->
<h2 class="dash-heading">Recent activity</h2>
<div class="report-grid-2">
    <section class="report-section">
        <table class="results">
            <tr><th>Latest returns</th><th>Borrower</th><th>Condition</th><th class="num">When</th></tr>
            @if (Model.RecentReturns.Count == 0)
            {
                <tr><td colspan="4">No returns yet.</td></tr>
            }
            @foreach (var r in Model.RecentReturns)
            {
                <tr>
                    <td>@r.Item</td>
                    <td>@r.Borrower</td>
                    <td><span class="pill @(r.Condition == "Good" ? "pill-ok" : "pill-warn")">@r.Condition</span></td>
                    <td class="num">@r.ReturnedAt.ToString("MMM d")</td>
                </tr>
            }
        </table>
    </section>

    <section class="report-section">
        <table class="results">
            <tr><th>Latest payments</th><th>Method</th><th class="num">Amount</th><th class="num">When</th></tr>
            @if (Model.RecentPayments.Count == 0)
            {
                <tr><td colspan="4">No payments yet.</td></tr>
            }
            @foreach (var p in Model.RecentPayments)
            {
                <tr>
                    <td>@p.Member</td>
                    <td>@(p.Method.Length > 0 ? char.ToUpper(p.Method[0]) + p.Method[1..] : p.Method)</td>
                    <td class="num">@p.Amount.ToString("C")</td>
                    <td class="num">@p.PaidAt.ToString("MMM d")</td>
                </tr>
            }
        </table>
    </section>
</div>

@section Scripts {
    <script>
        const dashboardGreeting = document.getElementById("staff-dashboard-greeting");
        const dashboardDate = document.getElementById("staff-dashboard-date");
        const dashboardDateFormat = new Intl.DateTimeFormat("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
            year: "numeric"
        });

        function updateDashboardHeader() {
            const now = new Date();
            const hour = now.getHours();
            let greeting;

            if (hour < 5 || hour >= 21) {
                greeting = "Good Night";
            } else if (hour < 12) {
                greeting = "Good Morning";
            } else if (hour < 17) {
                greeting = "Good Afternoon";
            } else {
                greeting = "Good Evening";
            }

            dashboardGreeting.textContent = greeting;
            dashboardDate.textContent = dashboardDateFormat.format(now);
        }

        updateDashboardHeader();
        window.setInterval(updateDashboardHeader, 30_000);
    </script>
}
