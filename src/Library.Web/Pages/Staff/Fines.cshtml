@page
@model Project.Pages.Staff.FinesModel

<p class="no-print"><a asp-page="/Staff/Index">&larr; Back to dashboard</a></p>

<section class="hero">
    <p class="eyebrow">Circulation</p>
    <h1>Fines &amp; Payments</h1>
    <p>Collect payments for overdue, damaged and lost item fines.</p>
</section>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Payment recorded.</strong> @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Payment not recorded.</strong> @Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="overview">
    <form method="get" class="search-form">
        <input type="text" name="Search" value="@Model.Search" placeholder="Member or item name" />
        <button type="submit" class="button button-primary">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-page="/Staff/Fines">Clear</a>
        }
        <a asp-page="/OverdueFines">View fines report</a>
    </form>
</section>

<section>
    <h2>Members with a balance (@Model.Balances.Count) · @Model.TotalOutstanding.ToString("C") outstanding</h2>
    @if (Model.Balances.Count == 0)
    {
        <p>No unpaid fines@(string.IsNullOrEmpty(Model.Search) ? "" : " match your search").</p>
    }
    else
    {
        <table class="results">
            <tr><th>Member</th><th class="num">Unpaid fines</th><th class="num">Balance</th><th>Oldest fine</th><th></th></tr>
            @foreach (var b in Model.Balances)
            {
                <tr>
                    <td>@b.Member</td>
                    <td class="num">@b.Fines</td>
                    <td class="num">@b.Balance.ToString("C")</td>
                    <td>@b.Oldest.ToString("MMM d, yyyy")</td>
                    <td><a asp-page="/Staff/Fines" asp-route-Search="@b.Member">Show fines</a></td>
                </tr>
            }
        </table>

        <h2 style="margin-top: 32px;">Unpaid fines (@Model.Unpaid.Count)</h2>
        <table class="results">
            <tr>
                <th class="num">#</th><th>Member</th><th>Item</th><th>Type</th><th class="num">Days late</th>
                <th>Assessed</th><th class="num">Amount</th><th>Take payment</th>
            </tr>
            @foreach (var f in Model.Unpaid)
            {
                <tr>
                    <td class="num">@f.FineId</td>
                    <td>@f.Member</td>
                    <td>@(f.ItemName ?? "—")</td>
                    <td>@f.FineType</td>
                    <td class="num">@(f.DaysLate is > 0 ? f.DaysLate.ToString() : "—")</td>
                    <td>@f.DateAssessed.ToString("MMM d, yyyy")</td>
                    <td class="num">@f.Amount.ToString("C")</td>
                    <td>
                        <form method="post" asp-page-handler="Pay" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="fineId" value="@f.FineId" />
                            <input type="hidden" name="Search" value="@Model.Search" />
                            <select name="method" class="form-select form-select-sm" style="width: auto;">
                                @foreach (var m in Project.Pages.Staff.FinesModel.Methods)
                                {
                                    <option value="@m">@(char.ToUpper(m[0]) + m[1..])</option>
                                }
                            </select>
                            <button type="button" class="btn btn-sm btn-primary js-pay"
                                    data-fine="@f.FineId"
                                    data-member="@f.Member"
                                    data-item="@(f.ItemName ?? "—")"
                                    data-type="@f.FineType"
                                    data-amount="@f.Amount.ToString("C")">
                                Pay
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </table>
    }

    <h2 style="margin-top: 32px;">Recent payments</h2>
    @if (Model.RecentPayments.Count == 0)
    {
        <p>No payments recorded yet.</p>
    }
    else
    {
        <table class="results">
            <tr><th>Payment</th><th>Member</th><th>For</th><th>Method</th><th>Date</th><th class="num">Amount</th></tr>
            @foreach (var p in Model.RecentPayments)
            {
                <tr>
                    <td>@p.PaymentId</td>
                    <td>@p.Member</td>
                    <td>@p.FineType</td>
                    <td>@p.Method</td>
                    <td>@p.PaymentDate.ToString("MMM d, yyyy")</td>
                    <td class="num">@p.Amount.ToString("C")</td>
                </tr>
            }
        </table>
    }
</section>

<!-- Payment confirmation window -->
<div class="modal fade" id="payModal" tabindex="-1" aria-labelledby="payModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="payModalTitle">Confirm payment</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Record this payment and mark the fine as paid?</p>
                <dl class="row mb-0">
                    <dt class="col-5">Member</dt>      <dd class="col-7" id="payMember"></dd>
                    <dt class="col-5">Item</dt>        <dd class="col-7" id="payItem"></dd>
                    <dt class="col-5">Fine</dt>        <dd class="col-7" id="payType"></dd>
                    <dt class="col-5">Payment method</dt><dd class="col-7" id="payMethod"></dd>
                    <dt class="col-5">Amount</dt>      <dd class="col-7 fs-5 fw-bold" id="payAmount"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="payConfirm">Record payment</button>
            </div>
        </div>
    </div>
</div>

<script>
    
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('payModal');
        if (!modalEl || typeof bootstrap === 'undefined') {
            
            document.querySelectorAll('.js-pay').forEach(function (b) { b.type = 'submit'; });
            return;
        }

        var modal = new bootstrap.Modal(modalEl);
        var pendingForm = null;
        var confirmBtn = document.getElementById('payConfirm');

        document.querySelectorAll('.js-pay').forEach(function (btn) {
            btn.addEventListener('click', function () {
                pendingForm = btn.closest('form');
                var method = pendingForm.querySelector('select[name="method"]');

                document.getElementById('payMember').textContent = btn.dataset.member;
                document.getElementById('payItem').textContent = btn.dataset.item;
                document.getElementById('payType').textContent = btn.dataset.type + ' (fine #' + btn.dataset.fine + ')';
                document.getElementById('payMethod').textContent = method.options[method.selectedIndex].text;
                document.getElementById('payAmount').textContent = btn.dataset.amount;

                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Record payment';
                modal.show();
            });
        });

        confirmBtn.addEventListener('click', function () {
            if (!pendingForm) return;
            confirmBtn.disabled = true;          // prevent double payments
            confirmBtn.textContent = 'Saving…';
            pendingForm.submit();
        });
    });
</script>
