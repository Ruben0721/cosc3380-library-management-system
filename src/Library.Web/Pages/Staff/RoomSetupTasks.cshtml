@page
@model Project.Pages.Staff.RoomSetupTasksModel

@{
	ViewData["Title"] = "Room Setup Tasks";
}

<section class="hero">
	<p class="eyebrow">Room reservations</p>
	<h1>Room Setup Tasks</h1>
	<p>Prepare rooms for upcoming reservations and mark completed work.</p>
</section>

@if (!string.IsNullOrEmpty(Model.Message))
{
	<div class="alert alert-success">@Model.Message</div>
}

@if (Model.Tasks.Count == 0)
{
	<p>No open room setup tasks.</p>
}
else
{
	<div class="table-responsive">
		<table class="results">
			<thead>
				<tr>
					<th>Room</th>
					<th>Reservation</th>
					<th>Reservation time</th>
					<th>People</th>
					<th>Task</th>
					<th>Created</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var task in Model.Tasks)
				{
					<tr>
						<td>@task.RoomId</td>
						<td>@task.ReservationId</td>
						<td>
							@task.StartTime.ToString("MMM d, yyyy h:mm tt")<br />
							to @task.EndTime.ToString("h:mm tt")
						</td>
						<td>@task.NumberOfPeople</td>
						<td>@task.Description</td>
						<td>@task.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
						<td>
							<form method="post" asp-page-handler="Complete">
								<input type="hidden" name="taskId" value="@task.TaskId" />
								<button type="submit" class="btn btn-sm btn-primary">
									Mark completed
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

<a asp-page="/RoomReservations" class="btn btn-outline-secondary mt-3">
	View room reservations
</a>
